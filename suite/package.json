{
  "name": "brood-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Layered Vitest proof suite and minimal Brood CLI",
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "build": "esbuild cli/src/index.ts --bundle --platform=node --target=node24 --format=esm --banner:js=\"import { createRequire } from 'module'; const require = createRequire(import.meta.url);\" --outfile=cli/dist/broodctl.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/l0 tests/l1",
    "test:l0": "vitest run tests/l0",
    "test:l1": "vitest run tests/l1",
    "test:l2": "vitest run tests/integration --testNamePattern='L2' --maxWorkers=1",
    "test:l3": "vitest run tests/integration --testNamePattern='L3' --maxWorkers=1",
    "test:l4": "vitest run tests/integration --testNamePattern='L4' --maxWorkers=1",
    "test:blast": "vitest run tests/integration --testNamePattern='blast radius' --maxWorkers=1",
    "test:int": "vitest run tests/integration --maxWorkers=1",
    "test:live": "BROOD_PROVIDER=real BROOD_LIVE_PROVIDER_CONFIRM=1 vitest run tests/live --maxWorkers=1"
  },
  "dependencies": {
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "@types/node": "24.0.10",
    "esbuild": "0.25.6",
    "tsx": "4.20.3",
    "typescript": "5.8.3",
    "vitest": "3.2.4"
  }
}
